PORT=3001
NODE_ENV=development

# ---- Supabase Postgres / Storage ----
# Use the Supavisor transaction-pooler URL (port 6543) on Vercel.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret key. Never expose it through NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=work-tracking-private
SUPABASE_STORAGE_PREFIX=line-works/
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=600
POSTGRES_POOL_MAX=3
POSTGRES_IDLE_TIMEOUT_SECONDS=20
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Notion Webhook / API ----
NOTION_WEBHOOK_VERIFICATION_TOKEN=
NOTION_API_TOKEN=
NOTION_API_VERSION=2022-06-28

# ---- GitHub Webhook ----
GITHUB_WEBHOOK_SECRET=

# ---- LINE WORKS SSO (organization sign-in) ----
LINE_WORKS_CLIENT_ID=
LINE_WORKS_CLIENT_SECRET=
LINE_WORKS_REDIRECT_URI=
LINE_WORKS_DOMAIN_ID=
LINE_WORKS_SCOPE=user.read
POST_LOGOUT_REDIRECT=/login

# ---- LINE WORKS Bot (chat room archive) ----
LINE_WORKS_BOT_ID=
LINE_WORKS_BOT_SECRET=
LINE_WORKS_SERVICE_ACCOUNT=
# Vercel: store the PEM value directly (escaped \n is also accepted).
LINE_WORKS_PRIVATE_KEY=
# Local fallback only.
LINE_WORKS_PRIVATE_KEY_PATH=./secrets/line-works-bot.pem
# Comma-separated channel IDs to archive. Use "*" to allow all channels the bot is in.
LINE_WORKS_TARGET_CHANNEL_IDS=

# ---- Legacy S3 source (one-time migrate:s3 command only) ----
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
