{
  "name": "work-tracking-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "dev:front": "npm --workspace front run dev",
    "dev:back": "npm --workspace back run start:dev",
    "build:front": "npm --workspace front run build",
    "build:back": "npm --workspace back run build",
    "lint:front": "npm --workspace front run lint",
    "lint:back": "npm --workspace back run lint",
    "build": "npm run build:front && npm run build:back",
    "lint": "npm run lint:front && npm run lint:back"
  },
  "devDependencies": {
    "supabase": "2.113.0"
  }
}
